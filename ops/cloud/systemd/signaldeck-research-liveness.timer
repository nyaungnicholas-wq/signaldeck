# Mirrors the trigger of Windows task 'SignalDeck Research-Liveness' in America/Los_Angeles wall time.
# Persistent=true is StartWhenAvailable: a run missed while the VM was down
# fires once at boot.
[Unit]
Description=SignalDeck Research-Liveness schedule

[Timer]
OnCalendar=*-*-* 08:15:00 America/Los_Angeles
Persistent=true
Unit=signaldeck-research-liveness.service

[Install]
WantedBy=timers.target
