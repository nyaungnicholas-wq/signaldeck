# Mirrors the trigger of Windows task 'SignalDeck Structural-Liveness' in America/Los_Angeles wall time.
# Persistent=true is StartWhenAvailable: a run missed while the VM was down
# fires once at boot.
[Unit]
Description=SignalDeck Structural-Liveness schedule

[Timer]
OnCalendar=*-*-* 08:30:00 America/Los_Angeles
Persistent=true
Unit=signaldeck-structural-liveness.service

[Install]
WantedBy=timers.target
