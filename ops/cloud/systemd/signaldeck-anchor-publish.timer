# Mirrors the trigger of Windows task 'SignalDeck Anchor-Publish' in America/Los_Angeles wall time.
# Persistent=true is StartWhenAvailable: a run missed while the VM was down
# fires once at boot.
[Unit]
Description=SignalDeck Anchor-Publish schedule

[Timer]
OnCalendar=*-*-* 19:30:00 America/Los_Angeles
Persistent=true
Unit=signaldeck-anchor-publish.service

[Install]
WantedBy=timers.target
