# Mirrors the trigger of Windows task 'SignalDeck Restore' in America/Los_Angeles wall time.
# Persistent=true is StartWhenAvailable: a run missed while the VM was down
# fires once at boot.
[Unit]
Description=SignalDeck Restore schedule

[Timer]
OnCalendar=Sun *-*-* 07:00:00 America/Los_Angeles
Persistent=true
Unit=signaldeck-restore.service

[Install]
WantedBy=timers.target
