# Mirrors the trigger of Windows task 'SignalDeck Market-Open' in America/Los_Angeles wall time.
# Persistent=true is StartWhenAvailable: a run missed while the VM was down
# fires once at boot.
[Unit]
Description=SignalDeck Market-Open schedule

[Timer]
OnCalendar=Mon..Fri *-*-* 06:20:00 America/Los_Angeles
Persistent=true
Unit=signaldeck-market-open.service

[Install]
WantedBy=timers.target
