# Mirrors the trigger of Windows task 'SignalDeck Market-Close' in America/Los_Angeles wall time.
# Persistent=true is StartWhenAvailable: a run missed while the VM was down
# fires once at boot.
[Unit]
Description=SignalDeck Market-Close schedule

[Timer]
OnCalendar=Mon..Fri *-*-* 13:10:00 America/Los_Angeles
Persistent=true
Unit=signaldeck-market-close.service

[Install]
WantedBy=timers.target
