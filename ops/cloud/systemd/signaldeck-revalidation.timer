# Mirrors the trigger of Windows task 'SignalDeck Revalidation' in America/Los_Angeles wall time.
# Persistent=true is StartWhenAvailable: a run missed while the VM was down
# fires once at boot.
[Unit]
Description=SignalDeck Revalidation schedule

[Timer]
OnCalendar=*-*-01 03:20:00 America/Los_Angeles
Persistent=true
Unit=signaldeck-revalidation.service

[Install]
WantedBy=timers.target
