# Mirrors the trigger of Windows task 'SignalDeck Check-Grader-Health' in America/Los_Angeles wall time.
# Persistent=true is StartWhenAvailable: a run missed while the VM was down
# fires once at boot.
[Unit]
Description=SignalDeck Check-Grader-Health schedule

[Timer]
OnCalendar=*-*-* 09:20:00 America/Los_Angeles
Persistent=true
Unit=signaldeck-check-grader-health.service

[Install]
WantedBy=timers.target
