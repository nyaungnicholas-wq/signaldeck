<?xml version="1.0" encoding="UTF-8"?>
<!--
  SignalDeck public tunnel LaunchAgent — ngrok maps a stable public HTTPS domain
  to the local daemon (127.0.0.1:8322) so TradingView alert webhooks can reach
  POST /api/tv-webhook. Reserved ngrok free static domain, so the URL survives
  restarts. The daemon's Host allowlist (SIGNALDECK_ALLOWED_HOSTS) must include
  this domain.

  ON-DEMAND / MARKET-HOURS MODEL (changed 2026-07-19): RunAtLoad=false, no
  KeepAlive — loads idle, runs only when kickstarted by com.signaldeck.market-open
  (weekdays 06:20 PT) or ops/signaldeck-ctl.sh (up|collect). Stopped at 13:10 PT.
  Bonus: the public URL is exposed only while you're actually collecting, not 24/7.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.signaldeck.tunnel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/natalienyaung/.local/bin/ngrok</string>
    <string>http</string>
    <string>8322</string>
    <string>--domain=spearfish-dwindle-module.ngrok-free.dev</string>
    <string>--log=stdout</string>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/natalienyaung/claude code/signaldeck/logs/tunnel.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/natalienyaung/claude code/signaldeck/logs/tunnel.err.log</string>
</dict>
</plist>
