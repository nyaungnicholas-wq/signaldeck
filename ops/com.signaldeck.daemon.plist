<?xml version="1.0" encoding="UTF-8"?>
<!--
  SignalDeck data daemon LaunchAgent — the collector (in-app agents for ingest,
  signals, expectancy, insights, honesty resolver, hud sync, DQ) plus the JSON
  API on :8322.

  ON-DEMAND / MARKET-HOURS MODEL (changed 2026-07-19):
  RunAtLoad=false and no KeepAlive, so this loads at login but stays IDLE. It
  only runs when kickstarted — by com.signaldeck.market-open (weekdays 06:20 PT)
  or manually via ops/signaldeck-ctl.sh (up|collect). com.signaldeck.market-close
  (13:10 PT) stops it. This is what stops it pinning the CPU 24/7.
  Start now:  ops/signaldeck-ctl.sh up
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.signaldeck.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/natalienyaung/claude code/signaldeck/bin/signaldeckd</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/natalienyaung/claude code/signaldeck/daemon</string>

  <key>RunAtLoad</key>
  <false/>

  <!--
    LOW-PRIORITY / STAY-OUT-OF-THE-WAY (added 2026-07-19):
    ProcessType=Background + Nice=20 put signaldeckd in the throttled background
    scheduling tier (same class as Spotlight/backups), so it yields CPU instantly
    whenever you're actively using the Mac and only uses spare cycles otherwise.
    LowPriorityIO deprioritizes its heavy SQLite disk writes too. It still runs
    and collects — it just can't hog the machine anymore.
  -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>20</integer>
  <key>LowPriorityIO</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/natalienyaung/claude code/signaldeck/logs/daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/natalienyaung/claude code/signaldeck/logs/daemon.err.log</string>
</dict>
</plist>
