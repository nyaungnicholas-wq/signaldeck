<?xml version="1.0" encoding="UTF-8"?>
<!--
  SignalDeck data daemon LaunchAgent — the 24/7 collector: 12 in-app agents
  (ingest, signals, expectancy, insights, honesty resolver, hud sync, DQ)
  plus the JSON API on :8322. This is the process that makes the database
  grow continuously.
  Install:
    cp ops/com.signaldeck.daemon.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.signaldeck.daemon.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.signaldeck.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/natalienyaung/claude code/signaldeck/bin/signaldeckd</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/natalienyaung/claude code/signaldeck/daemon</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!--
    Log growth: the daemon now rotates its own log in-process — slog goes to
    BOTH stderr and logs/signaldeckd.log (20 MB x 3 generations; override the
    path with SIGNALDECK_LOG_FILE, or set it to "" to disable file logging).
    The launchd redirects below are kept ON PURPOSE as a crash net: they
    capture panics, runtime faults, and anything printed before logging is
    initialized — output the in-process writer can miss. Trade-off:
    daemon.err.log duplicates slog output and still grows unbounded; if that
    ever matters, point StandardErrorPath at /dev/null — signaldeckd.log
    carries the same stream, rotated.
  -->
  <key>StandardOutPath</key>
  <string>/Users/natalienyaung/claude code/signaldeck/logs/daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/natalienyaung/claude code/signaldeck/logs/daemon.err.log</string>
</dict>
</plist>
