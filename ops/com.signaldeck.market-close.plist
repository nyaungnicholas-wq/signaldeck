<?xml version="1.0" encoding="UTF-8"?>
<!--
  SignalDeck market-close trigger. Weekdays at 13:10 Pacific (10 min after the
  US regular session closes, 13:00 PT / 16:00 ET) it stops the whole stack
  (daemon + tunnel + web) via signaldeck-ctl.sh, freeing CPU and letting the
  Mac sleep. Pairs with com.signaldeck.market-open.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.signaldeck.market-close</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/natalienyaung/claude code/signaldeck/ops/market-close.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>10</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/natalienyaung/claude code/signaldeck/logs/schedule.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/natalienyaung/claude code/signaldeck/logs/schedule.err.log</string>
</dict>
</plist>
