<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.signaldeck.research-liveness</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/natalienyaung/claude code/signaldeck/ops/research-liveness.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/natalienyaung/claude code/signaldeck/logs/research-liveness.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/natalienyaung/claude code/signaldeck/logs/research-liveness.out.log</string>
	<!-- 08:15 local: after the overnight research loop has finished and long
	     before the 14:05 accuracy-registry publish, so a missing judgment
	     ledger is dated on the morning it happened rather than discovered by
	     an attempt to publish. -->
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>15</integer></dict>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/natalienyaung/claude code/signaldeck</string>
</dict>
</plist>
