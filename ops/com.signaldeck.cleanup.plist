<?xml version="1.0" encoding="UTF-8"?>
<!--
  SignalDeck daily housekeeping trigger — runs ops/signaldeck-cleanup.sh:
  trims old DB backups to the 2 newest (older ones go to ~/.Trash) and rotates
  any logs/*.log over 10 MB to gzipped generations (.1.gz … .3.gz). Fires daily
  at 14:05 local, after the 13:15 daily-refresh burst; launchd coalesces a
  missed run to the next wake, so a closed lid delays it, never skips it.
  Install: cp to ~/Library/LaunchAgents && launchctl load ~/Library/LaunchAgents/com.signaldeck.cleanup.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.signaldeck.cleanup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/natalienyaung/claude code/signaldeck/ops/signaldeck-cleanup.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>14</integer>
    <key>Minute</key><integer>5</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/natalienyaung/claude code/signaldeck/logs/cleanup.sched.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/natalienyaung/claude code/signaldeck/logs/cleanup.sched.log</string>
</dict>
</plist>
