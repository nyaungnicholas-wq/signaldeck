<?xml version="1.0" encoding="UTF-8"?>
<!-- Keeps the Mac awake (idle-sleep prevention) so the SignalDeck 24/7
     collectors actually run 24/7. caffeinate -i blocks idle sleep while the
     lid is open / on AC; display may still sleep (that's fine). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.signaldeck.awake</string>
  <key>ProgramArguments</key><array><string>/usr/bin/caffeinate</string><string>-i</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
