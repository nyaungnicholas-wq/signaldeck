data/
bin/
logs/
.next/
# Isolated build outputs. next.config.ts honours SIGNALDECK_DIST_DIR so a
# candidate can be built and served without replacing the directory the running
# instances indexed at boot, and ops/web-release.ps1 keeps the previous build as
# .next-prev-<stamp> rather than deleting it. All of them are build output.
.next-release-*/
.next-prev-*/
.next-public/
node_modules/
.env
.env.*
!.env.example

# Working files from one-off research runs. Anything worth keeping gets a
# durable home beside the code that serves it (e.g. the pairs study result is
# embedded at daemon/internal/pairsstudy/result.json).
scratchpad/

# Local build outputs and scratch verification trees. Absent from a clone by
# design; ops/manifest-check.sh skips gitignored paths for exactly this reason.
daemon/sdmaint
.tmpverify/
*.bak-[0-9]*

# Python bytecode from running the tools/tests locally.
__pycache__/
# Pre-migration VACUUM INTO backups. Consistent, restorable, and far too large
# to track; regenerate with the snippet in ops/IMPROVE_BACKLOG.md.
*.premigration

# Worker-generated research scripts from ops/eighty-loop.ps1 are TRACKED
# (un-ignored 2026-08-04). They are generated, but they are also the only
# executable form of a recorded result: logs/eighty-research.md cites them by
# name, and the protocol's acceptance criteria require a result to reproduce
# from a cold clone. Ignoring them meant a journal entry could point at a file
# nobody outside this machine had, and -- until the numbering fix in 6cd9966 --
# at a file that had since been overwritten by a later run.
#
# COST, so it is not a surprise later: every loop cycle now writes a tracked
# file, so a running loop leaves the tree dirty and
# ops/signaldeck-ctl.sh deploy refuses until those scripts are committed.
# That refusal is correct -- the deploy gate exists so the binary IS the
# commit -- but it now fires roughly daily instead of never.

# Quarantined artifacts. These are multi-GB database copies set aside BECAUSE
# they failed verification — evidence to keep on disk, never history to carry.
# A 439 MB corrupt backup was committed here on 2026-08-02 and had to be removed
# with filter-branch; the repo is ignoring the directory so it cannot recur.
quarantine/

# Measurement outputs from the tools/alpha/*.py scripts. Regenerable by rerunning
# the tracked script that wrote them; untracked so a stale run cannot make the
# daemon refuse to start on an "unattributable build".
tools/alpha/*.json
# fetch_form25.py writes its report to the CWD, so running it from the repo root
# drops a copy here that the rule above cannot see. Same regenerable artifact.
/form25_report.json

# scratch / scratch-pad files
web/scratch_*.mjs
*.new.tsx

.venv/

# Runtime maintenance lock (ops/daemon-guard.ps1, market-close.sh,
# signaldeck-ctl.sh deploy). Present only while downtime is deliberate, but
# untracked it dirties the tree and build_from_head refuses to deploy during
# any backup window.
ops/.maintenance

# Kill switch (daemon/internal/killswitch). A file here HALTS new entries.
# Runtime state, never committed: a halt is local and must not travel in git.
ops/HALT

# Frozen evidence captures (ops/freeze-corpus.sh). These are local forensic
# snapshots — the 2026-08-04 remediation capture alone is 4.7 GB because it
# includes a copy of the database. Evidence about a moment, not part of the
# published system, and far past anything git should carry. The PROOF of a
# freeze belongs in proofs/; the freeze itself stays on the machine that took
# it. Ignored explicitly so ops/manifest-check.sh does not read a mention of
# this directory in a tracked document as a load-bearing path a clone lacks.
freeze/

# EDGAR fetch cache (tools/alpha/fetch_form25.py). Raw SEC responses keyed by
# CIK and quarter, so a re-run costs no requests and the SEC is not hammered
# for data that cannot change: a filed Form 25 index and a company's rendered
# cover page are immutable once published. ~230 MB for 2024 alone, dominated by
# four form.idx files (QTR1 is 57.8 MB by itself). Safe to delete at any time —
# the next run just refetches. Never a build input, so it is ignored explicitly
# rather than left for someone to discover as a 1 GB surprise in git status.
tools/alpha/.cache_edgar/
ops/accuracy_progress.json
ops/STOP-OVERNIGHT

# Go build output landing beside its package (the release binaries live in
# the already-ignored bin/). caldiag.exe is rebuilt by `go build ./cmd/caldiag`
# in seconds, so a 10 MB copy in git status is noise, not an artifact.
daemon/*.exe
# Graphify page-graph cache: regenerated on demand, never a build input.
graphify-out/

# Go coverage profile: a build artifact. CI regenerates it every run and
# uploads it as the go-coverage artifact; a committed copy would be stale the
# moment any test changes.
daemon/coverage.out

# Compiled daemon binaries. daemon/*.exe was ignored; the extensionless macOS
# and Linux builds were not, so two stale 2026-08-02 Mach-O artifacts totalling
# 32.7 MB were tracked, shipped in every clone, pulled into the Docker build
# context by `COPY daemon/ ./`, and carried the original developer absolute home
# path inside them. Nothing references either file.
daemon/signaldeckd
daemon/compact_proof

# Generated by ops/docker-build.sh immediately before `docker build`, on the
# host where git exists. It binds the image to the reviewed source by content
# hash; see tools/build_manifest.py. Never committed - it describes one build.
/build-manifest.json

# Emitted by the same script, beside the manifest: this repository's COMMIT
# objects, packed so the container grader can resolve the revision stamped on
# every historical forecast row (Dockerfile unpacks it into /app/.git). ~830 KB,
# regenerated per build, describes one build exactly as the manifest does.
#
# It has to be ignored, not merely uncommitted: ops/docker-build.sh refuses a
# dirty tree via sd_dirty_excluding_generated, which reads `git status
# --porcelain` and so counts UNTRACKED files. Left visible, the first build
# would leave this behind and the second would refuse itself.
/build-commits.pack
