+  else
+    log "sweep_open set ${age}s ago, under the ${MINAGE}s ceiling — a sweep is still working"
+  fi
+fi
+if [ "$FORCE" = "prune-only" ]; then
+  [ -z "$stale" ] && log "prune-only: universe not open — nothing to do"
+  exit 0
+fi
