--- a/daemon/internal/marketdata/types.go
+++ b/daemon/internal/marketdata/types.go
@@ -56,6 +56,14 @@
 	// as opposed to the BROAD DAILY-ONLY universe (REST daily bars only).
 	// Broad-universe wave; legacy/daily-only symbols are false.
 	Stream bool `json:"stream"`
+	// Delisted is true when symbols.delisted_at records a MARKET fact: this
